# =========================================================================
# OpenBOQ — datos de conexión al repositorio central de precios
# -------------------------------------------------------------------------
# Copiar este archivo como  supabase/.env.local  y rellenarlo con los datos
# del panel de Supabase. El .env.local está en .gitignore: NO se versiona.
#
# Dónde sacar cada dato:
#   Supabase → el proyecto → Project Settings → API      (URL y las claves)
#   Supabase → el proyecto → Project Settings → Database (la cadena de conexión)
# =========================================================================

# Dirección del proyecto. Es pública, no es un secreto.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave pública. Va a ir dentro de la aplicación cuando se agreguen los
# aportes (fase 4). Sola no sirve para nada: el RLS la frena.
SUPABASE_ANON_KEY=

# Clave de servicio. SALTA EL RLS: lee, escribe y borra todo.
# Solo para los scripts de migración de este equipo. Nunca en la aplicación,
# nunca en el repositorio, nunca por correo o chat.
SUPABASE_SERVICE_KEY=

# Cadena de conexión directa a Postgres, para las migraciones masivas.
# Lleva adentro la contraseña de la base: mismo cuidado que la de servicio.
SUPABASE_DB_URL=postgresql://postgres:CONTRASENA@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres
